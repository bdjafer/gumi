{
  "name": "@gumi/media-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:contract": "node --test tests/contracts.test.mjs tests/edge-muxer-conformance.test.mjs",
    "test:core": "node --test tests/core.test.mjs",
    "test:integration": "node --test tests/http-integration.test.mjs",
    "test:boundary": "node --test tests/boundary.test.mjs",
    "typecheck": "node scripts/check-sources.mjs",
    "lint": "node --test tests/boundary.test.mjs",
    "build": "node scripts/check-sources.mjs",
    "verify": "npm run typecheck && npm run test:contract && npm run test:core && npm run test:integration && npm run test:boundary && npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}
