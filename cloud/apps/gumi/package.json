{
  "name": "gumi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "type": "module",
  "imports": {
    "#core/*": "./core/*.ts",
    "#deps": "./deps.ts",
    "#env": "./env.ts",
    "#functions": "./functions/index.ts",
    "#functions/*": "./functions/*.ts",
    "#integrations/*": "./integrations/*.ts",
    "#runtime": "./runtime/index.ts",
    "#runtime/*": "./runtime/*.ts",
    "#schema": "./schema/index.ts",
    "#simulation/*": "./simulation/*.ts",
    "#views": "./views/index.ts"
  },
  "scripts": {
    "dev": "astrale-domain dev",
    "prod": "astrale-domain prod",
    "deploy": "astrale-domain deploy",
    "build": "astrale-domain build",
    "generate:media-ingest": "openapi-typescript ../media-ingest/api/v1/openapi.json -o integrations/media-ingest/generated/media-ingest-v1.d.ts --immutable",
    "generate:media-processing": "openapi-typescript ../media-processing/api/v1/openapi.json -o integrations/media-processing/generated/media-processing-v1.d.ts --immutable",
    "check:media-ingest": "node scripts/check-media-ingest-generated.mjs",
    "check:media-processing": "node scripts/check-media-processing-generated.mjs",
    "lint": "astrale-domain lint",
    "lint:fix": "astrale-domain lint --fix",
    "typecheck": "tsgo --noEmit",
    "test": "pnpm check:media-ingest && pnpm check:media-processing && vitest run --config vitest.config.ts --passWithNoTests",
    "verify:client": "pnpm --filter astrale-domain-client verify",
    "verify": "pnpm check:media-ingest && pnpm check:media-processing && pnpm typecheck && pnpm lint && pnpm test && pnpm verify:client && pnpm build"
  },
  "dependencies": {
    "@astrale-os/adapter-astrale": ">=0.4.1 <1.0.0",
    "@astrale-os/kernel-core": ">=0.7.5 <1.0.0",
    "@astrale-os/kernel-dsl": ">=0.1.4 <1.0.0",
    "@astrale-os/sdk": ">=0.4.9 <1.0.0",
    "@hono/node-server": "^1.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrale-os/ox": ">=0.1.3 <1.0.0",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "latest",
    "openapi-typescript": "7.13.0",
    "oxlint": ">=1.72.0 <2.0.0",
    "typescript": "~6.0.1-rc",
    "vitest": "^3.2.4",
    "wrangler": ">=4.106.0 <5.0.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.13.1",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
