{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "schema",
    "core",
    "integrations",
    "runtime",
    "views",
    "deps.ts",
    "env.ts",
    "domain.ts",
    "icons.ts",
    "astrale.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".astrale", ".dist"]
}
