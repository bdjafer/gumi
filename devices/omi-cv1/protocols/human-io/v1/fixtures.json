        "output_patterns": [
          { "at_ms": 450, "indicator": "ready_link_status" }
        ],
        "terminal": {
          "mic_truth": "verified_off",
          "base_recording": "inactive"
        },
        "forbidden": [
          "microphone_acquire_request",
          "audio_frame",
          "base_recording_started",
          "voice_turn_started"
        ]
      }
    },
