{
  "schema": "gumi.device-human-io-fixtures/v1",
  "protocol": "gumi.omi-cv1-human-io/v1",
  "contract": "contract.json",
  "status": "proposed_unqualified",
  "time_unit": "monotonic_millisecond",
  "conventions": {
    "default_input_layer": "accepted_debounced_logical_edges",
    "raw_level_change_cases_name_the_input_layer_explicitly": true,
    "same_timestamp_precedence": [
      "accepted_button_edges",
      "gesture_deadlines"
    ],
    "semantic_event_traces_are_exhaustive_per_consumer_owner": true,
    "effect_completions_are_explicit_inputs": true,
    "absence_in_forbidden_applies_to_entire_case": true,
    "terminal_verified_idle_requires_fresh_device_evidence": true
  },
  "cases": [
    {
      "id": "debounce-collapses-switch-bounce",
      "operation": "debounce",
      "input_layer": "raw_level_changes",
      "initial_level": "released",
      "inputs": [
        { "at_ms": 0, "type": "raw_button_level", "value": "pressed" },
        { "at_ms": 10, "type": "raw_button_level", "value": "released" },
        { "at_ms": 18, "type": "raw_button_level", "value": "pressed" },
        { "at_ms": 100, "type": "raw_button_level", "value": "released" }
      ],
      "expected": {
        "accepted_edges": [
          { "at_ms": 48, "type": "button_down" },
          { "at_ms": 130, "type": "button_up" }
        ],
        "forbidden": [
          "additional_button_down",
          "additional_button_up"
        ]
      }
    },
