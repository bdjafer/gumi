      "single_tap": "repeat_maintenance_or_fault_status",
      "double_tap": "ignored",
      "hold_committed": "ignored_unless_disclosed_recovery_step_owns_input"
    },
    "fatal_privacy": {
      "single_tap": "repeat_fault_status",
      "double_tap": "ignored",
      "hold_committed": "ignored"
    },
    "off": {
      "first_qualified_press": "wake",
      "remaining_gesture_interpretation": "disabled_until_operational"
    }
