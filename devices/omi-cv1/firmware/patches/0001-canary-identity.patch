 static void boot_led_sequence(void)
 {
-    // Quick blue pulse = "I'm alive, booting..."
-    set_led_blue(true);
-    k_msleep(300);
-    led_off();
+    // Gumi canary identity only: three short magenta pulses before any microphone startup.
