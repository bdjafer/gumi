diff --git a/omi/firmware/omi/CMakeLists.txt b/omi/firmware/omi/CMakeLists.txt
--- a/omi/firmware/omi/CMakeLists.txt
+++ b/omi/firmware/omi/CMakeLists.txt
@@ -24,7 +24,16 @@ if(CONFIG_OMI_ENABLE_OFFLINE_STORAGE)
     list(APPEND core_sources src/lib/core/storage.c)
 endif()
 
-target_sources(app PRIVATE ${core_sources} ${app_sources})
+# Gumi integration probe: compile the portable kernels and the Omi v3.0.12 mic port.
+file(GLOB gumi_probe_sources
+    src/gumi/button.c
+    src/gumi/capture.c
+    src/gumi/feedback.c
+    src/gumi/zephyr/omi-v3012/mic_port.c
+)
+
+target_sources(app PRIVATE ${core_sources} ${app_sources} ${gumi_probe_sources})
+target_include_directories(app PRIVATE src/gumi/include)
 
 if(CONFIG_OMI_CODEC_OPUS)
     add_subdirectory(src/lib/core/lib/opus-1.2.1/)
