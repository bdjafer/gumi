#!/bin/sh
set -eu

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
workspace_java_home="$repo_dir/local/toolchains/jdk-17.0.19+10/Contents/Home"
workspace_android_sdk="$repo_dir/local/toolchains/android-sdk"

if [ -x "$workspace_java_home/bin/java" ]; then
    export JAVA_HOME="$workspace_java_home"
elif [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    : # Preserve the explicitly selected host/CI JDK.
elif command -v java >/dev/null 2>&1; then
    : # Gradle may use the JDK already selected on PATH.
else
    echo "No usable JDK found (workspace toolchain, JAVA_HOME, or PATH)." >&2
    echo "Follow docs/development/bootstrap.md before running the build." >&2
    exit 1
fi

if [ -d "$workspace_android_sdk" ]; then
    export ANDROID_SDK_ROOT="$workspace_android_sdk"
elif [ -n "${ANDROID_SDK_ROOT:-}" ] && [ -d "$ANDROID_SDK_ROOT" ]; then
    : # Preserve the explicitly selected host/CI SDK.
elif [ -n "${ANDROID_HOME:-}" ] && [ -d "$ANDROID_HOME" ]; then
    export ANDROID_SDK_ROOT="$ANDROID_HOME"
else
    echo "No usable Android SDK found (workspace toolchain, ANDROID_SDK_ROOT, or ANDROID_HOME)." >&2
    echo "Follow docs/development/bootstrap.md before running the build." >&2
    exit 1
fi

export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$repo_dir/local/gradle-home}"
export ANDROID_USER_HOME="${ANDROID_USER_HOME:-$repo_dir/local/android-user-home}"

exec "$repo_dir/gradlew" "$@"
